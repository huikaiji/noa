<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOA路测事件记录仪</title>
<style>
:root{--blue:#286dc4;--red:#d84646;--ink:#26364c;--muted:#697c92;--line:#dfe6ef;--soft:#f6f9fd}
*{box-sizing:border-box}
html{font-size:14px;-webkit-text-size-adjust:100%}
body{max-width:980px;margin:0 auto;padding:12px;background:#f3f6fa;color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.4}
.box{background:#fff;padding:15px 17px;border:1px solid #e9eef4;border-radius:12px;margin-bottom:10px;box-shadow:0 1px 4px #23334a0c}
h3{font-size:20px;line-height:1.3;margin:0 0 12px}
h4{font-size:15px;line-height:1.4;margin:0 0 7px}
h5{font-size:13px;margin:0}
button,input,select,textarea{font:inherit}
select,input[type="text"],input[type="number"],input[type="date"]{min-width:0;max-width:100%;border:1px solid #d2dce7;border-radius:7px;background:#fff;color:var(--ink);padding:7px 9px;min-height:36px}
button{touch-action:manipulation}
select{width:100%}
input[type="checkbox"],input[type="radio"]{accent-color:var(--blue);width:16px;height:16px;flex:none;margin:0}
textarea{display:block;width:100%;min-height:176px;padding:9px;border:1px solid #d2dce7;border-radius:8px;font-size:13px;line-height:1.5;resize:vertical}
#issueArea{min-height:95px}
.btn{border:0;border-radius:7px;min-height:36px;padding:7px 11px;margin:0;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap}
.btn-blue{background:#2875ca;color:#fff}.btn-terrain{background:#0f766e;color:#fff}.btn-red{background:#d64646;color:#fff}.btn-light{background:#edf2f8;color:#41617f;border:1px solid #d7e1eb}
.btn:active{filter:brightness(.9)}
:focus-visible{outline:3px solid #9cc8fc;outline-offset:2px}
.meta-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:8px 10px;margin-bottom:11px}
.meta-field{grid-column:span 3;display:flex;flex-direction:column;gap:4px;min-width:0}
.meta-field span{font-size:12px;color:#536982;font-weight:600}
.meta-field.mile{grid-column:span 4}.meta-field.route{grid-column:span 8}
.help-intro{font-size:12px;color:var(--muted);margin:0 0 8px;line-height:1.45}
.quick-section{padding-top:10px;margin-top:10px;border-top:1px solid #eaf0f5}
.quick-section h4{margin-bottom:7px}
.btn-line{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.event-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:7px}
.event-row .btn{min-width:64px}
.event-row select,.event-row input[type="text"]{width:100%;min-width:0}
.inline-tte,.tte-label{display:inline-flex;align-items:center;gap:5px;color:#445b73;white-space:nowrap;font-size:12px;cursor:pointer}
.long-header{margin:10px 0 7px;display:flex;justify-content:space-between;gap:6px;align-items:center;flex-wrap:wrap}
.long-header h4{margin:0}.long-hint{font-size:11px;color:var(--muted)}
.terrain-panel,.longitudinal-panel{border:1px solid var(--line);border-radius:9px;padding:11px;margin:8px 0}
.terrain-panel{background:#f7faff;border-color:#dce8f7}.longitudinal-panel{background:#fff}
.subhead{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.subhead h5{font-size:14px;color:#31577e}
.pill-meta{font-size:10px;padding:2px 7px;border-radius:12px;background:#e8f1fb;color:#426b95}
.terrain-group-title{font-size:12px;font-weight:600;color:#58718a;margin:8px 0 5px}
.terrain-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.terrain-chip{display:flex;align-items:center;justify-content:flex-start;gap:6px;min-width:0;min-height:34px;padding:6px 8px;border:1px solid #d9e4f0;border-radius:7px;background:#fff;font-size:12px;cursor:pointer}
.terrain-chip:has(input:checked){background:#e3f0ff;color:#1c5ca1;border-color:#83b3eb;font-weight:650}
.issue-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:9px}
.issue-card{min-width:0;border:1px solid #e0e7ef;background:#f9fbfe;border-radius:8px;padding:9px}
.issue-card h5{color:#28517e;font-size:13px;margin:0 0 3px}
.small-help{color:var(--muted);font-size:11px;margin:0 0 6px}
.issue-picker{border:1px solid #cfdae7;border-radius:7px;background:#fff;min-width:0}
.issue-picker summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:5px;min-height:37px;padding:7px 8px;font-size:12px}
.issue-picker summary::-webkit-details-marker{display:none}
.issue-picker summary:after{content:'⌄';color:#6a819d;font-size:16px;margin-left:2px}.issue-picker[open] summary:after{content:'⌃'}
.issue-picker[open] summary{border-bottom:1px solid #e2e8f0}
.selected-count{margin-left:auto;color:#2766ab;min-width:0;max-width:62%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}
.issue-options{max-height:210px;overflow-y:auto;padding:4px;overscroll-behavior:contain}
.issue-option{display:flex;align-items:center;gap:7px;min-height:35px;padding:5px 6px;font-size:12px;cursor:pointer;border-radius:5px}
.issue-option:has(input:checked){background:#e5f0ff;color:#235d99;font-weight:650}
.pcc-single{display:flex;align-items:center;gap:7px;background:#fff;border:1px solid #cfdae7;border-radius:7px;padding:7px 8px;min-height:37px;font-size:12px;cursor:pointer}
.pcc-single:has(input:checked){background:#e5f0ff;color:#235d99;border-color:#82b4ed;font-weight:650}
.note-details{margin:8px 0 0;border:1px dashed #dbe4ee;border-radius:7px;background:#fbfdff;padding:5px 9px}
.note-details summary{font-size:12px;color:#607893;cursor:pointer}
.note-details input{margin-top:7px;width:100%;font-size:13px}
.long-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;border-top:1px solid #e8edf3;padding-top:9px;margin-top:9px}
.long-actions .btn{min-height:37px}.long-actions .tte-label{margin-right:auto}
.selection-status{font-size:12px;color:#62778f;margin:6px 0 0;overflow-wrap:anywhere}
.selection-status.recorded{color:#167142;font-weight:600}
.actions-bottom{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}
.title-row{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:0 0 7px}
.title-row h4{margin:0}
.stat{background:#f1f5ff;border-radius:8px;padding:10px;font-size:13px;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}
@media(max-width:700px){
 body{padding:7px;background:#f2f5f9}
 .box{padding:11px 10px;border-radius:9px;margin-bottom:7px}
 h3{font-size:17px;margin-bottom:9px}
 .meta-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
 .meta-field,.meta-field.mile{grid-column:span 1}.meta-field.route{grid-column:span 2}
 .meta-field span{font-size:11px}
 .meta-field select,.meta-field input{font-size:16px;min-height:35px;padding:5px 7px}
 .help-intro{font-size:11px}
 .quick-section{padding-top:8px;margin-top:8px}
 .quick-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
 .quick-actions .btn{font-size:12px;min-width:0;width:100%;min-height:35px}
 .long-header{margin:8px 0 6px}.long-hint{display:none}
 .terrain-panel,.longitudinal-panel{padding:9px;margin:7px 0}
 .terrain-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}
 .terrain-chip{min-height:32px;font-size:12px;padding:5px 7px}
 .terrain-group-title{margin:7px 0 4px}
 .issue-grid{display:flex;flex-direction:column;gap:6px;margin-top:7px}
 .issue-card{display:grid;grid-template-columns:53px minmax(0,1fr);align-items:center;column-gap:6px;padding:5px 7px}
 .issue-card h5{margin:0;grid-column:1;font-size:13px}
 .issue-card .small-help{display:none}
 .issue-picker,.pcc-single{grid-column:2;min-width:0}
 .issue-picker summary{min-height:35px;padding:5px 7px}
 .issue-options{max-height:168px}
 .issue-option{min-height:36px}
 .pcc-single{min-height:35px;font-size:12px;padding:5px 7px}
 .long-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;padding-top:8px;margin-top:7px}
 .long-actions .tte-label{grid-column:1/-1;min-height:24px}
 .long-actions .btn{font-size:12px;width:100%;white-space:normal;min-height:36px;padding:6px}
 .long-actions .btn-light{grid-column:1/-1;min-height:30px}
 .event-row{grid-template-columns:minmax(0,1fr) auto 58px;gap:6px}
 .event-row .btn{min-width:58px;padding:6px}
 .event-row select,.event-row input[type=text]{font-size:13px;min-height:36px;padding:5px 6px}
 .inline-tte{font-size:11px;gap:3px}
 .inline-tte input{width:15px;height:15px}
 .title-row h4{font-size:14px}
 textarea{min-height:135px;font-size:13px}#issueArea{min-height:78px}
 .stat{font-size:12px;padding:8px}
}
@media(max-width:350px){
 .pill-meta{font-size:9px}.terrain-chip{font-size:11px}
 .event-row{grid-template-columns:minmax(0,1fr) auto 53px}.event-row .btn{min-width:53px;font-size:12px}
}
</style>
</head>
<body>
<div class="box">
<h3>🚗 NOA路测事件记录仪</h3>
<div class="meta-grid">
<label class="meta-field"><span>日期</span><input id="testDate" type="date"></label>
<label class="meta-field"><span>车辆</span><select id="testCar">
<option value="377车" selected>377车</option><option value="382车">382车</option><option value="383车">383车</option><option value="251车">251车</option><option value="混动725车">混动725车</option></select></label>
<label class="meta-field"><span>重量</span><select id="testWeight">
<option value="空头">空头</option><option value="35t">35t</option><option value="36t">36t</option><option value="37t">37t</option><option value="38t">38t</option><option value="39t">39t</option><option value="40t" selected>40t</option><option value="41t">41t</option></select></label>
<label class="meta-field"><span>天气</span><select id="testWeather">
<option value="晴天" selected>晴天</option><option value="阴天">阴天</option><option value="雨天">雨天</option><option value="夜间">夜间</option></select></label>
<label class="meta-field mile"><span>总里程 (km)</span><input id="totalMile" type="number" inputmode="decimal" min="0" placeholder="例如 300" value="300"></label>
<label class="meta-field route"><span>测试路线</span><input id="routeText" type="text" placeholder="例如 永乐东-腰市" value="永乐东-腰市"></label>
</div>
<p class="help-intro">问题单选，平原/山区可与问题关联或单独记录；坡道场景可直接点击蓝色按钮记录。日志自动保存到当前浏览器。</p>

<div class="quick-section">
<h4>✅正常事件记录（直接点击）</h4>
<div class="btn-line quick-actions">
<button class="btn btn-blue" onclick="addNormalLog('正常跟车')">正常跟车</button>
<button class="btn btn-blue" onclick="addNormalLog('正常前车切入')">正常前车切入</button>
<button class="btn btn-blue" onclick="addNormalLog('正常避让')">正常避让</button>
<button class="btn btn-blue" onclick="addNormalLog('正常拨杆换道')">正常拨杆换道</button>
<button class="btn btn-blue" onclick="addNormalLog('正常自动换道')">正常自动换道</button>
<button class="btn btn-blue" onclick="addNormalLog('通过隧道')">通过隧道</button>
<button class="btn btn-blue" onclick="addNormalLog('通过匝道')">通过匝道</button>
<button class="btn btn-terrain" onclick="addNormalLog('下坡→上坡')">下坡→上坡</button>
<button class="btn btn-terrain" onclick="addNormalLog('上坡→下坡')">上坡→下坡</button>
<button class="btn btn-terrain" onclick="addNormalLog('长上坡')">长上坡</button>
<button class="btn btn-terrain" onclick="addNormalLog('上下坡')">上下坡</button>
</div>
</div>

<div>
<div class="long-header"><h4>🔴纵向问题记录</h4><span class="long-hint">地形条件与纵向问题可关联记录</span></div>
<section class="terrain-panel" aria-labelledby="terrainTitle">
<div class="subhead"><h5 id="terrainTitle">🗻 地形条件</h5><span class="pill-meta">道路形态单选</span></div>
<div class="terrain-group-title">道路形态</div>
<div class="terrain-grid"><label class="terrain-chip"><input type="radio" name="terrainForm" class="terrain-tag" value="平原"><span>平原</span></label>
<label class="terrain-chip"><input type="radio" name="terrainForm" class="terrain-tag" value="山区"><span>山区</span></label></div>
</section>
<section class="longitudinal-panel" aria-labelledby="longIssuesTitle">
<div class="subhead"><h5 id="longIssuesTitle">纵向问题</h5><span class="pill-meta">巡航 / 跟车 / PCC 全局单选</span></div>
<div class="issue-grid">
<section class="issue-card">
<h5>① 巡航</h5>
<p class="small-help">定速 / 限速 / 加减速</p>
<details class="issue-picker" id="picker巡航">
<summary><span>选择问题（单选）</span><span class="selected-count" id="count巡航">未选择</span></summary>
<div class="issue-options"><label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="下坡超速"><span>下坡超速</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="弯道超速"><span>弯道超速</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="异常掉空档"><span>异常掉空档</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="速度低于设定值"><span>速度低于设定值</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="动力不足"><span>动力不足</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="加速过猛"><span>加速过猛</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="速度反复波动"><span>速度反复波动</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="异常制动"><span>异常制动</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="制动过晚"><span>制动过晚</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="制动过猛"><span>制动过猛</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="巡航" value="顿挫"><span>顿挫</span></label></div>
</details>
</section>
<section class="issue-card">
<h5>② 跟车</h5>
<p class="small-help">车距 / 前车切入切出</p>
<details class="issue-picker" id="picker跟车">
<summary><span>选择问题（单选）</span><span class="selected-count" id="count跟车">未选择</span></summary>
<div class="issue-options"><label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="跟车距离过近"><span>跟车距离过近</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="跟车距离过远"><span>跟车距离过远</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="跟车速度波动"><span>跟车速度波动</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="前车减速响应晚"><span>前车减速响应晚</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="跟车制动过猛"><span>跟车制动过猛</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="跟车过近未制动"><span>跟车过近未制动</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="前车切入响应晚"><span>前车切入响应晚</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="前车切入制动过猛"><span>前车切入制动过猛</span></label>
<label class="issue-option"><input type="radio" name="longIssue" class="long-issue" data-category="跟车" value="前车切出加速恢复慢"><span>前车切出加速恢复慢</span></label></div>
</details>
</section>
<section class="issue-card">
<h5>③ PCC</h5>
<p class="small-help">仅保留一个重点问题</p>
<label class="pcc-single"><input type="radio" name="longIssue" class="long-issue" data-category="PCC" value="下坡接上坡冲坡不足"><span>下坡接上坡冲坡不足</span></label>
</section>
</div>
<details class="note-details"><summary>补充描述（选填）</summary>
<input id="longNote" type="text" maxlength="240" placeholder="如坡度、车速或具体路段"></details>
<div class="long-actions">
<label class="tte-label"><input type="checkbox" id="tteLong">TTE</label>
<button type="button" class="btn btn-red" onclick="addLongitudinalLog(false)">记录纵向问题</button>
<button type="button" class="btn btn-blue" onclick="addLongitudinalLog(true)">仅记录地形</button>
<button type="button" class="btn btn-light" onclick="clearLongSelection()" title="清除本次选择">清除选择</button>
</div>
<div class="selection-status" id="longSelectionStatus" role="status" aria-live="polite">尚未选择问题或地形</div>
</section>
</div>

 <div class="quick-section">
<h4>🔴LCC问题</h4>
<div class="event-row">
<select id="selLcc">
<option value="">--选择LCC问题--</option>
<option value="超车压线">超车压线</option>
<option value="弯道内压线">弯道内压线</option>
<option value="画龙">画龙</option>
<option value="LCC持续偏右">LCC持续偏右</option>
<option value="LCC持续偏左">LCC持续偏左</option>
</select>
<label class="inline-tte"><input type="checkbox" id="tteLcc">TTE</label>
<button class="btn btn-red" onclick="addLogFromSelect('selLcc','tteLcc')">记录</button>
</div>
</div>

<div class="quick-section">
<h4>🔴避让问题</h4>
<div class="event-row">
<select id="selAvoid">
<option value="">--选择避让问题--</option>
<option value="避让晚">避让晚</option>
<option value="避让未提示">避让未提示</option>
<option value="未避让">未避让</option>
<option value="避让压线">避让压线</option>
<option value="避让播报延迟">避让播报延迟</option>
</select>
<label class="inline-tte"><input type="checkbox" id="tteAvoid">TTE</label>
<button class="btn btn-red" onclick="addLogFromSelect('selAvoid','tteAvoid')">记录</button>
</div>
</div>

<div class="quick-section">
<h4>🔴换道问题</h4>
<div class="event-row">
<select id="selLc">
<option value="">--选择换道问题--</option>
<option value="拨杆换道失败">拨杆换道失败</option>
<option value="自动换道失败">自动换道失败</option>
</select>
<label class="inline-tte"><input type="checkbox" id="tteLc">TTE</label>
<button class="btn btn-red" onclick="addLogFromSelect('selLc','tteLc')">记录</button>
</div>
</div>

<div class="quick-section">
<h4>🔴匝道问题</h4>
<div class="event-row">
<select id="selRamp">
<option value="">--选择匝道问题--</option>
<option value="匝道压线">匝道压线</option>
<option value="匝道前不减速">匝道前不减速</option>
<option value="匝道内行驶左侧车道">匝道内行驶左侧车道</option>
<option value="出匝道未避让">出匝道未避让</option>
<option value="匝道转向不足">匝道转向不足</option>
<option value="匝道转向过度">匝道转向过度</option>
<option value="匝道画龙">匝道画龙</option>
<option value="匝道入口不自动汇入">匝道入口不自动汇入</option>
<option value="匝道速度过快">匝道速度过快</option>
<option value="匝道速度过慢">匝道速度过慢</option>
</select>
<label class="inline-tte"><input type="checkbox" id="tteRamp">TTE</label>
<button class="btn btn-red" onclick="addLogFromSelect('selRamp','tteRamp')">记录</button>
</div>
</div>

