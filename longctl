<script>
//本地存储KEY
const STORAGE_KEY_LOG = "noa_log_content";
const STORAGE_KEY_ISSUE = "noa_issue_content";
const STORAGE_KEY_DATE = "noa_test_date";
const STORAGE_KEY_CAR = "noa_test_car";
const STORAGE_KEY_WEIGHT = "noa_test_weight";
const STORAGE_KEY_WEATHER = "noa_test_weather";
const STORAGE_KEY_MILE = "noa_total_mile";
const STORAGE_KEY_ROUTE = "noa_route_text";

// 获取当前日期字符串 yyyy-MM-dd
function getTodayStr(){
    const d=new Date();
    const y=d.getFullYear();
    const m=(d.getMonth()+1).toString().padStart(2,'0');
    const day=d.getDate().toString().padStart(2,'0');
    return `${y}-${m}-${day}`;
}
//获取日志头部信息文本
function getLogHeaderText(){
    const dateVal = document.getElementById('testDate').value;
    const carVal = document.getElementById('testCar').value;
    const weightVal = document.getElementById('testWeight').value;
    const weatherVal = document.getElementById('testWeather').value;
    const routeVal = document.getElementById('routeText').value;
    const dateShow = dateVal.replace(/(\d{4})-(\d{2})-(\d{2})/, "$1年$2月$3日");
    return `${dateShow}，${carVal} ${weightVal},${weatherVal}，${routeVal}`;
}

// 将旧版纵向日志转换为与横向记录一致的简洁格式。
// 仅迁移本地保存的历史记录，迁移前留一份原始备份，避免数据丢失。
function normalizeLegacyLogLine(line){
    const match = line.match(/^(\d{2}:\d{2}:\d{2}\s+)(.*)$/);
    if(!match) return [line];
    const time = match[1], event = match[2];
    const tte = /\s+tte$/.test(event) ? ' tte' : '';
    const withoutTte = event.replace(/\s+tte$/,'');
    const segments = withoutTte.split('｜');
    const detail = segments.slice(1).map(x=>x.trim()).filter(Boolean);
    const extra = detail.filter(x=>!/^正常通过$/.test(x)).map(x=>'，'+x).join('');

    if(withoutTte.startsWith('地形场景：')) {
        const terrain = segments[0].slice('地形场景：'.length);
        return [time + '地形：' + terrain + extra];
    }
    if(withoutTte.startsWith('PCC场景：')) {
        const terrain = segments[0].slice('PCC场景：'.length);
        return [time + '地形：' + terrain + extra];
    }
    if(withoutTte.startsWith('ACC纵向：')) {
        const main = segments[0].slice('ACC纵向：'.length);
        const items=[];
        for(const m of main.matchAll(/(?:巡航|跟车|PCC)\[([^\]]*)\]/g)){
            for(const issue of m[1].split('、').map(x=>x.trim()).filter(Boolean)){
                items.push(time+issue+extra+tte);
            }
        }
        return items.length ? items : [line];
    }
    const oldCategory = withoutTte.match(/^ACC-(巡航|跟车)：(.+)$/);
    if(oldCategory) return [time+oldCategory[2].trim()+tte];
    if(withoutTte.startsWith('ACC-PCC：')) {
        const rest=segments[0].slice('ACC-PCC：'.length).trim();
        const issue=detail.find(x=>x && !x.startsWith('备注：') && x!=='正常通过');
        const note=detail.find(x=>x.startsWith('备注：'));
        const terrain=rest ? '，地形：'+rest : '';
        return issue ? [time+issue+terrain+(note?'，'+note:'')+tte] : [line];
    }
    return [line];
}
function normalizeLegacyLog(text){
    return text.split('\n').flatMap(normalizeLegacyLogLine).join('\n');
}

//页面加载读取本地存储
window.onload = function(){
    const saveLog = localStorage.getItem(STORAGE_KEY_LOG);
    const saveIssue = localStorage.getItem(STORAGE_KEY_ISSUE);
    const saveDate = localStorage.getItem(STORAGE_KEY_DATE);
    const saveCar = localStorage.getItem(STORAGE_KEY_CAR);
    const saveWeight = localStorage.getItem(STORAGE_KEY_WEIGHT);
    const saveWeather = localStorage.getItem(STORAGE_KEY_WEATHER);
    const saveMile = localStorage.getItem(STORAGE_KEY_MILE);
    const saveRoute = localStorage.getItem(STORAGE_KEY_ROUTE);

    // 本地存储优先，没有则使用预设默认值
    document.getElementById('testDate').value = saveDate || getTodayStr();
    document.getElementById('testCar').value = saveCar || "377车";
    document.getElementById('testWeight').value = saveWeight || "40t";
    document.getElementById('testWeather').value = saveWeather || "晴天";
    document.getElementById('totalMile').value = saveMile || "300";
    document.getElementById('routeText').value = saveRoute || "永乐东-腰市";

    if(saveLog!==null){
        const normalizedLog = normalizeLegacyLog(saveLog);
        if(normalizedLog !== saveLog){
            const backupKey = STORAGE_KEY_LOG + '_backup_before_format_update';
            if(localStorage.getItem(backupKey) === null) localStorage.setItem(backupKey, saveLog);
            localStorage.setItem(STORAGE_KEY_LOG, normalizedLog);
        }
        document.getElementById('logArea').value = normalizedLog;
    }
    if(saveIssue!==null) document.getElementById('issueArea').value = saveIssue;

    //监听输入变更自动保存
    document.getElementById('testDate').addEventListener('input',()=>{
        localStorage.setItem(STORAGE_KEY_DATE,document.getElementById('testDate').value);
    })
    document.getElementById('testCar').addEventListener('change',()=>{
        localStorage.setItem(STORAGE_KEY_CAR,document.getElementById('testCar').value);
    })
    document.getElementById('testWeight').addEventListener('change',()=>{
        localStorage.setItem(STORAGE_KEY_WEIGHT,document.getElementById('testWeight').value);
    })
    document.getElementById('testWeather').addEventListener('change',()=>{
        localStorage.setItem(STORAGE_KEY_WEATHER,document.getElementById('testWeather').value);
    })
    document.getElementById('totalMile').addEventListener('input',()=>{
        localStorage.setItem(STORAGE_KEY_MILE,document.getElementById('totalMile').value);
    })
    document.getElementById('routeText').addEventListener('input',()=>{
        localStorage.setItem(STORAGE_KEY_ROUTE,document.getElementById('routeText').value);
    })
    document.getElementById('logArea').addEventListener('input',()=>{
        localStorage.setItem(STORAGE_KEY_LOG,document.getElementById('logArea').value);
    })
    document.getElementById('issueArea').addEventListener('input',()=>{
        localStorage.setItem(STORAGE_KEY_ISSUE,document.getElementById('issueArea').value);
    })
}
// 获取当前时分秒
function getNowTime(){
let d=new Date();
let h=d.getHours().toString().padStart(2,'0');
let m=d.getMinutes().toString().padStart(2,'0');
let s=d.getSeconds().toString().padStart(2,'0');
return `${h}:${m}:${s}`;
}
// 追加文本到日志框
function appendLogLine(line){
const ta=document.getElementById('logArea');
let currentText=ta.value;
// 如果日志为空，先写入头部信息
if(currentText.trim() === ""){
    currentText = getLogHeaderText() + "\n";
}
if(currentText!=="" && !currentText.endsWith("\n")) currentText+="\n";
ta.value = currentText + line;
localStorage.setItem(STORAGE_KEY_LOG,ta.value);
}

//正常事件按钮点击（无TTE）
function addNormalLog(eventName){
    const time=getNowTime();
    let line=`${time} ${eventName}`;
    appendLogLine(line);
}

//介入事件按钮点击（独立TTE）
function addInterveneLog(typeName, tteId){
    const tteCb = document.getElementById(tteId);
    let reason = prompt(`请输入${typeName}具体原因：`,"");
    if(reason===null) return;
    const time=getNowTime();
    let line=`${time} ${typeName}：${reason.trim()}`;
    if(tteCb.checked){
        line += ` tte`;
        tteCb.checked = false;
    }
    appendLogLine(line);
}

//从下拉选择添加日志
function addLogFromSelect(selId,tteId){
    const sel = document.getElementById(selId);
    const tteCb = document.getElementById(tteId);
    const eventName = sel.value.trim();
    if(!eventName){
        alert("请先选择事件");
        return;
    }
    const time=getNowTime();
    let line=`${time} ${eventName}`;
    if(tteCb.checked){
        line += ` tte`;
        tteCb.checked = false;
    }
    appendLogLine(line);
    sel.value = "";
}

// 纵向问题全局单选；平原/山区道路形态单选；坡道场景使用上方正常事件快捷按钮记录。
// 日志格式与横向事件一致：时间 + 问题描述，可选附加地形和备注。
function getCheckedValues(selector){
    return Array.from(document.querySelectorAll(selector + ':checked'), el => el.value);
}
function updateLongSelection(){
    const terrain = getCheckedValues('.terrain-tag');
    const issue = document.querySelector('.long-issue:checked');
    for(const category of ['巡航','跟车']){
        const count = document.getElementById('count'+category);
        const selected = document.querySelector('.long-issue[data-category="'+category+'"]:checked');
        count.textContent = selected ? selected.value : '未选择';
    }
    document.getElementById('longSelectionStatus').textContent =
        `${issue ? '问题：'+issue.value : '未选择纵向问题'}；${terrain.length ? '地形：'+terrain.join('、') : '未选择地形'}`;
}
function clearLongSelection(){
    document.querySelectorAll('.long-issue,.terrain-tag').forEach(el=>{el.checked=false;});
    document.getElementById('longNote').value='';
    document.querySelector('.note-details').open=false;
    document.getElementById('tteLong').checked=false;
    document.querySelectorAll('.issue-picker').forEach(el=>{el.open=false;});
    document.getElementById('longSelectionStatus').classList.remove('recorded');
    updateLongSelection();
}
function addLongitudinalLog(terrainOnly){
    const terrain = getCheckedValues('.terrain-tag');
    const issue = document.querySelector('.long-issue:checked');
    const note = (document.getElementById('longNote')?.value || '').trim().replace(/[\r\n]+/g,' ');
    if(terrainOnly){
        if(!terrain.length){alert('请先选择至少一个地形条件');return;}
        if(issue && !confirm('已选择纵向问题。仅记录地形不会记录问题，确定继续吗？')) return;
    } else if(!issue){
        alert('请先在巡航、跟车或 PCC 中选择一项问题');return;
    }
    let line = `${getNowTime()} `;
    if(terrainOnly){
        line += `地形：${terrain.join('、')}`;
    } else {
        line += issue.value;
        if(terrain.length) line += `，地形：${terrain.join('、')}`;
    }
    if(note) line += `，备注：${note}`;
    if(!terrainOnly && document.getElementById('tteLong').checked) line += ' tte';
    appendLogLine(line);
    clearLongSelection();
    const feedback = document.getElementById('longSelectionStatus');
    feedback.textContent = '✓ 已记录：' + line.replace(/^\d{2}:\d{2}:\d{2}\s+/, '');
    feedback.classList.add('recorded');
}
document.addEventListener('change',e=>{
    if(e.target.matches('.long-issue')) document.querySelectorAll('.issue-picker').forEach(el=>{el.open=false;});
    if(e.target.matches('.terrain-tag,.long-issue')) {
        document.getElementById('longSelectionStatus').classList.remove('recorded');
        updateLongSelection();
    }
});

//自定义事件
function addOtherLogFromSelect(){
    const input = document.getElementById('otherInput');
    const tteCb = document.getElementById('tteOther');
    const text=input.value.trim();
    if(!text){alert("请输入其他问题描述");return;}
    const time=getNowTime();
    let line=`${time} ${text}`;
    if(tteCb.checked){
        line += ` tte`;
        tteCb.checked = false;
    }
    appendLogLine(line);
    input.value='';
}

//清空本地全部日志+问题点
function clearLocalLog(){
if(!confirm("确认清空全部本地日志+主要问题点？数据将无法恢复！")) return;
document.getElementById('logArea').value = "";
document.getElementById('issueArea').value = "";
localStorage.removeItem(STORAGE_KEY_LOG);
localStorage.removeItem(STORAGE_KEY_ISSUE);
}
//复制全部日志
async function copyLog(){
const text = document.getElementById('logArea').value;
if(!text || text.trim() === ""){
alert("日志内容为空，无法复制");
return;
}
try{
await navigator.clipboard.writeText(text);
alert("✅全部原始日志已复制");
}catch(err){
alert("❌复制失败，请浏览器允许剪贴板权限，可以手动全选拷贝");
}
}
//复制主要问题点（单独）
async function copyIssue(){
const text = document.getElementById('issueArea').value;
if(!text || text.trim() === ""){
alert("主要问题点为空，无法复制");
return;
}
try{
await navigator.clipboard.writeText(text);
alert("✅主要问题点已复制");
}catch(err){
alert("❌复制失败，可以手动全选拷贝");
}
}
//复制路测统计
async function copyStatText(){
const statText = document.getElementById('statBox').innerText;
if(!statText || statText.trim() === ""){
alert("请先点击【刷新完整统计】生成统计内容");
return;
}
try{
await navigator.clipboard.writeText(statText);
alert("✅路测统计已复制");
}catch(err){
alert("❌复制失败，可以手动全选拷贝统计文本");
}
}

//统计计算：使用你给的模板格式输出
function calcStat(){
const rawText=document.getElementById('logArea').value;
const mileInput=parseFloat(document.getElementById('totalMile').value);
const mile = isNaN(mileInput) || mileInput <=0 ? 0 : mileInput;
const dateStr = document.getElementById('testDate').value;
const carStr = document.getElementById('testCar').value;
const weightStr = document.getElementById('testWeight').value;
const weatherStr = document.getElementById('testWeather').value;
const routeStr = document.getElementById('routeText').value || "未填写";

let dateShow = dateStr.replace(/(\d{4})-(\d{2})-(\d{2})/, "$1年$2月$3日");

const lines = rawText.split('\n');
let cnt={
safeIntervene:0,unSafeIntervene:0,lccDragon:0,
ilcOk:0,ilcFail:0,alcOk:0,alcFail:0,
accErrBrake:0,accCruise:0,accFollow:0,accPcc:0,
avoidOk:0,avoidFail:0,tunnelOk:0,tunnelFail:0,rampOk:0,rampFail:0
};
// 按网页实际提供的问题选项分类，新版单选日志无需 ACC 前缀也能正确计数。
const issueCategories = new Map();
document.querySelectorAll('.long-issue').forEach(el=>issueCategories.set(el.value,el.dataset.category));
// 兼容历史版本中缺少分类或已下线的纵向选项。
const historicCategories = {
 '未制动':'巡航','超速':'巡航','异常顿挫':'巡航','加速响应慢':'巡航',
 '前车切入响应晚':'跟车','跟车距离过近':'跟车'
};
function countIssue(category,issue){
    const key = category === '巡航' ? 'accCruise' : category === '跟车' ? 'accFollow' : category === 'PCC' ? 'accPcc' : null;
    if(key) cnt[key]++;
    if(issue==='异常制动') cnt.accErrBrake++;
}
lines.forEach(line=>{
    const l=line.trim();
    if(!l) return;
    const event=l.replace(/^\d{2}:\d{2}:\d{2}\s+/, '');
    if(event.startsWith('非安全介入')) cnt.unSafeIntervene++;
    else if(event.startsWith('安全介入')) cnt.safeIntervene++;
    if((event.includes('画龙') && !event.includes('匝道画龙')) || event.includes('LCC持续偏右') || event.includes('LCC持续偏左')) cnt.lccDragon++;
    if(event.includes('正常拨杆换道')) cnt.ilcOk++;
    if(event.includes('拨杆换道失败')) cnt.ilcFail++;
    if(event.includes('正常自动换道')) cnt.alcOk++;
    if(event.includes('自动换道失败')) cnt.alcFail++;

    // 新版：问题描述，地形：...，备注：... tte
    const simpleIssue = event.split('，')[0].replace(/\s+tte$/,'').trim();
    if(issueCategories.has(simpleIssue)){
        countIssue(issueCategories.get(simpleIssue),simpleIssue);
    } else if(historicCategories[simpleIssue]) {
        countIssue(historicCategories[simpleIssue],simpleIssue);
    } else if(event.startsWith('ACC纵向：')){
        // 上一版支持多个问题的日志：分类[问题1、问题2]；分类[问题3]
        const main = event.split('｜')[0];
        for(const match of main.matchAll(/(巡航|跟车|PCC)\[([^\]]*)\]/g)){
            match[2].split('、').filter(Boolean).forEach(issue=>countIssue(match[1],issue));
        }
    } else {
        // 更早版本：ACC-巡航：问题 或 ACC-PCC：地形｜问题
        const categoryMatch=event.match(/^ACC-(巡航|跟车|PCC)：(.+)$/);
        if(categoryMatch){
            const parts=categoryMatch[2].split('｜');
            const raw=categoryMatch[1]==='PCC' && parts.length>1 ? parts[1] : parts[0];
            const issue=raw.replace(/\s+tte$/,'').trim();
            if(issue) countIssue(categoryMatch[1],issue);
        }
    }
    // 仅分类真正的问题行；独立的“地形：”不计入问题统计。
    if(event.includes('正常避让')) cnt.avoidOk++;
    if(event.includes('避让晚')||event.includes('避让未提示')||event.includes('未避让')||event.includes('避让压线')||event.includes('避让播报延迟')) cnt.avoidFail++;
    if(event.includes('通过隧道')) cnt.tunnelOk++;
    if(event.includes('通过匝道')) cnt.rampOk++;
    if(event.includes('匝道压线')||event.includes('匝道前不减速')||event.includes('匝道内行驶左侧车道')||event.includes('出匝道未避让')||event.includes('匝道转向不足')
       ||event.includes('匝道转向过度')||event.includes('匝道画龙')||event.includes('匝道入口不自动汇入')||event.includes('匝道速度过快')||event.includes('匝道速度过慢')) cnt.rampFail++;
});

function perK(count){
if(mile<=0) return "-";
return (count / mile *1000).toFixed(1);
}
function rate(ok,fail){
let total=ok+fail;
if(total===0) return "100％";
return (ok/total*100).toFixed(0)+"％";
}

let out="";
out += `${dateShow}，${carStr} ${weightStr},${weatherStr}，${routeStr}\n`;
out += `1. 总里程：${mile>0?mile:'未填写'}km\n`;
out += `2. 安全介入次数：${cnt.safeIntervene}次，实际指标：${perK(cnt.safeIntervene)}次/千公里\n`;
out += `3. 非安全介入次数：${cnt.unSafeIntervene}次，实际指标：${perK(cnt.unSafeIntervene)}次/千公里\n`;
out += `4. 车道保持（画龙）：${cnt.lccDragon}次，实际指标：${perK(cnt.lccDragon)}次/千公里\n`;
out += `5. 拨杆换道ILC：总共${cnt.ilcOk+cnt.ilcFail}次，失败${cnt.ilcFail}次，实际指标：${rate(cnt.ilcOk,cnt.ilcFail)}\n`;
out += `6. 自动换道ALC: 总共${cnt.alcOk+cnt.alcFail}次，失败${cnt.alcFail}次，实际指标：${rate(cnt.alcOk,cnt.alcFail)}\n`;
out += `7. 纵向控制：异常制动${cnt.accErrBrake}次，${perK(cnt.accErrBrake)}次/千公里\n`;
out += `   · 巡航问题：${cnt.accCruise}次，${perK(cnt.accCruise)}次/千公里\n`;
out += `   · 跟车问题：${cnt.accFollow}次，${perK(cnt.accFollow)}次/千公里\n`;
out += `   · PCC问题：${cnt.accPcc}次，${perK(cnt.accPcc)}次/千公里\n`;
out += `8. 智能避让：总共${cnt.avoidOk+cnt.avoidFail}次，失败${cnt.avoidFail}次，实际指标：${rate(cnt.avoidOk,cnt.avoidFail)}\n`;
out += `9. 隧道通行成功率：总共${cnt.tunnelOk+cnt.tunnelFail}次，失败${cnt.tunnelFail}次，实际指标：${rate(cnt.tunnelOk,cnt.tunnelFail)}\n`;
out += `10. 匝道辅助: 总共${cnt.rampOk+cnt.rampFail}次，失败${cnt.rampFail}次，实际指标：${rate(cnt.rampOk,cnt.rampFail)}。`;
document.getElementById('statBox').innerText=out;
}
</script>
